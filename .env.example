# ============================================================
# Brandex — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to git.
# ============================================================

# ─── Supabase (Primary Database, Auth, and Storage) ─────────
# Public browser configuration. Access remains protected by Supabase Auth + RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# ─── Google Sheet Mirror ─────────────────────────────────────
# Server-side secrets for the Supabase Edge Function only.
# Configure these with `supabase secrets set`; never expose them as VITE_* values.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_APPS_SCRIPT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
SHEET_SYNC_CRON_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET

# Required by the Sheet mirror Edge Function.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── Client Ledger Edge Function bridge ────────────────────
# Set these only as Supabase Edge Function secrets (never VITE_* or Vercel
# browser variables). The same random integration secret is required on the
# Ledger project's `cms-payment-status` Edge Function.
LEDGER_PAYMENT_STATUS_URL=https://YOUR_LEDGER_PROJECT_REF.supabase.co/functions/v1/cms-payment-status
LEDGER_CMS_INTEGRATION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
